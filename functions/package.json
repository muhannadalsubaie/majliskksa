{
  "name": "majlisk-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "copy-shared": "rm -rf src/shared && cp -r ../shared src/shared && find src/shared -name '*.test.ts' -delete",
    "build": "npm run copy-shared && tsc",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "~5.9"
  }
}
