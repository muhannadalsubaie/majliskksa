{
  // خادم مجلسك على Cloudflare Workers — الحكَم الوحيد على العملات وقانونية الحركات
  "name": "majlisk-api",
  // معرّف حساب Cloudflare — ليس سراً
  "account_id": "ea9eb2bdb9c44e3c7a79f118b2f159c6",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // نسخة الويب مقفلة: العنوان يقدّم صفحة تعريف وسياسة الخصوصية وحذف الحساب فقط؛ الخادم يستقبل /api
  "assets": {
    "directory": "./site",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // تنظيف قائمة الطاولات كل 10 دقائق
  "triggers": { "crons": ["*/10 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "TableRoom" },
      { "name": "HUBS", "class_name": "UserHub" },
      { "name": "VOICES", "class_name": "VoiceRoom" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["UserHub"] },
    { "tag": "v3", "new_sqlite_classes": ["VoiceRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["Presence"] }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "majlisk-87eef",
    // مؤقتاً "1" أثناء التجربة بإعلانات Google التجريبية؛ تُغيّر إلى "0" عند ربط وحدة إعلان حقيقية مع SSV
    "ADS_TEST_REWARDS": "0",
    // حسابات المطوّر (عملات لا محدودة): SHA-256 للإيميل الموثّق — الإيميل نفسه لا يُكتب هنا
    "UNLIMITED_EMAIL_SHA256": "34c088887a89d4497a11ba360b3f80ec39bfbdee8c3cffb5fb74c7f440622f1a",
    // المحادثة الصوتية: معرّف تطبيق Cloudflare Realtime (ليس سرياً)
    "REALTIME_APP_ID": "b9dc7cb41b0be4a33dfb022a20110f94"
  }
  // الأسرار (تُضبط من GitHub Actions، لا تُكتب هنا):
  //   FIREBASE_SERVICE_ACCOUNT — ملف JSON لحساب خدمة Firebase
  //   REALTIME_APP_SECRET — مفتاح تطبيق Cloudflare Realtime (المحادثة الصوتية)
}
